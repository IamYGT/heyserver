# Public HTTPS origin of the HServer control plane. No credentials, query, or
# fragment are allowed in this URL.
HSERVER_AGENT_HUB_URL=https://hserver.example.com

# Provider-neutral node identifier registered in the HServer panel.
HSERVER_AGENT_NODE_ID=node-1

# Store the one-time enrollment token outside this environment file.
HSERVER_AGENT_TOKEN_FILE=/etc/hserver-agent.token

# Heartbeat and task-poll interval. Accepted range: 5s to 1h.
HSERVER_AGENT_INTERVAL=30s

# Bounded pre-upgrade recovery window shared by panel and agent lifecycle
# installers. Accepted range: 1 to 100.
HSERVER_UPGRADE_SNAPSHOT_RETENTION_COUNT=3

# Comma-separated systemd units visible in inventory. Leave empty when service
# observation is not wanted.
HSERVER_AGENT_OBSERVED_SERVICES=

# Explicit service-action allowlist. Only listed units may be started, stopped,
# or restarted. Example: nginx.service,docker.service
HSERVER_AGENT_ALLOWED_SERVICES=

# Explicit host-action allowlist. Supported values are memory-optimize,
# swap-reset, temp-clean, reboot, and reboot-cancel. Example enabling all:
# HSERVER_AGENT_ALLOWED_HOST_ACTIONS=memory-optimize,swap-reset,temp-clean,reboot,reboot-cancel
HSERVER_AGENT_ALLOWED_HOST_ACTIONS=

# Process inventory is always read-only by default. Enable this explicit toggle
# to allow stable-identity SIGTERM and SIGKILL tasks from the panel.
HSERVER_AGENT_ALLOW_PROCESS_SIGNALS=false

# Enables an outbound, multiplexed, writable root terminal relay. The lifecycle
# installer relaxes the agent service sandbox only when this is exactly true.
HSERVER_AGENT_ALLOW_TERMINAL=false

# Fixed disk cleanup scopes exposed to the panel. Commands and paths are not
# accepted from the hub; only these IDs exist in the agent protocol.
# Example: apt-cache,journal,tmp-old,rotated-logs
HSERVER_AGENT_ALLOWED_DISK_CLEANUP=

# Journal sources exposed through fixed journalctl arguments. PHP-FPM,
# PostgreSQL, and PM2 use version/user-neutral systemd unit patterns.
# Example: system,nginx,php,mariadb,postgresql,pm2,docker
HSERVER_AGENT_ALLOWED_LOG_SOURCES=

# Docker inventory and lifecycle controls are separate local opt-ins. The hub
# can never provide a Docker subcommand outside this fixed action vocabulary.
HSERVER_AGENT_ALLOW_CONTAINER_READ=false
# Example: start,restart,stop
HSERVER_AGENT_ALLOWED_CONTAINER_ACTIONS=

# Runs only `nginx -t` and an optional nginx.service reload.
# Example: test,reload
HSERVER_AGENT_ALLOWED_NGINX_ACTIONS=

# Nginx config roots are local agent policy and may be changed for distributions
# using a different layout. Write requires read and remains disabled by default.
HSERVER_AGENT_ALLOW_NGINX_CONFIG_READ=false
HSERVER_AGENT_ALLOW_NGINX_CONFIG_WRITE=false
HSERVER_AGENT_NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
HSERVER_AGENT_NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
HSERVER_AGENT_ALLOW_DOMAIN_READ=false
HSERVER_AGENT_ALLOW_DOMAIN_ACTIONS=false

# Certbot certificate inventory and actions are separate local opt-ins. Renew
# uses only the selected certificate name, then validates and reloads Nginx.
HSERVER_AGENT_ALLOW_SSL_READ=false
HSERVER_AGENT_ALLOW_SSL_ACTIONS=false
HSERVER_AGENT_CERTBOT_CONFIG_DIR=/etc/letsencrypt
HSERVER_AGENT_CERTBOT_WORK_DIR=/var/lib/letsencrypt
HSERVER_AGENT_CERTBOT_LOGS_DIR=/var/log/letsencrypt
HSERVER_AGENT_CERTBOT_BINARY=/usr/bin/certbot
HSERVER_AGENT_OPENSSL_BINARY=/usr/bin/openssl
HSERVER_AGENT_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Database inventory uses local Unix-socket/peer identities and never exports
# credentials. Restart permission is selected per supported engine.
HSERVER_AGENT_ALLOW_DATABASE_READ=false
# Example: mariadb,postgresql
HSERVER_AGENT_ALLOWED_DATABASE_RESTARTS=
HSERVER_AGENT_MARIADB_BINARY=/usr/bin/mariadb
HSERVER_AGENT_MARIADB_ADMIN_BINARY=/usr/bin/mariadb-admin
HSERVER_AGENT_PG_LSCLUSTERS_BINARY=/usr/bin/pg_lsclusters
HSERVER_AGENT_PSQL_BINARY=/usr/bin/psql
HSERVER_AGENT_PG_ISREADY_BINARY=/usr/bin/pg_isready

# Backup plans are installation-owned systemd services declared in a local
# JSON file. The hub can select only a plan ID from that file.
HSERVER_AGENT_ALLOW_BACKUP_READ=false
HSERVER_AGENT_ALLOW_BACKUP_RUN=false
HSERVER_AGENT_BACKUP_PLANS_FILE=/etc/hserver/backup-plans.json

# Deploy targets and exact argv are defined locally. Read exposes only bounded
# plan metadata. Actions execute only an action declared in that plan file.
HSERVER_AGENT_ALLOW_DEPLOY_READ=false
HSERVER_AGENT_ALLOW_DEPLOY_ACTIONS=false
# Project-domain inventory and mutations are separate opt-ins. The reverse
# proxy port comes only from host_port in the local deploy plan.
HSERVER_AGENT_ALLOW_DEPLOY_DOMAIN_READ=false
HSERVER_AGENT_ALLOW_DEPLOY_DOMAIN_ACTIONS=false
HSERVER_AGENT_DEPLOY_PLANS_FILE=/etc/hserver/deploy-plans.json
HSERVER_AGENT_DEPLOY_ACME_WEBROOT=/var/www/hserver-acme
# Optional systemd sandbox write exceptions required by local release commands.
# Example: /srv/apps,/var/lib/example-app
HSERVER_AGENT_DEPLOY_WRITE_ROOTS=

# Agent release discovery and lifecycle mutations are separate local opt-ins.
# The hub sends only an exact stable version or rollback action; the manifest
# URL, checksum, download, staging paths, installer, and systemd argv remain
# controlled by this server. Actions require read.
HSERVER_AGENT_ALLOW_UPDATE_READ=false
HSERVER_AGENT_ALLOW_UPDATE_ACTIONS=false
HSERVER_AGENT_UPDATE_MANIFEST_URL=
# Optional comma-separated base64 Ed25519 public keys. When set, the adjacent
# .sig is required. Multiple keys support rotation.
HSERVER_AGENT_UPDATE_MANIFEST_PUBLIC_KEYS=
HSERVER_AGENT_STATE_DIR=/var/lib/hserver-agent
HSERVER_AGENT_LIFECYCLE_INSTALLER=/usr/local/libexec/hserver-agent-install
HSERVER_AGENT_SYSTEMD_RUN_BINARY=/usr/bin/systemd-run
HSERVER_AGENT_SYSTEMCTL_BINARY=/usr/bin/systemctl

# Comma-separated clean absolute roots for bounded text-file management. Read
# and write roots are local policy; write roots must also appear in read roots.
# Example: /srv/apps,/etc/example-service
HSERVER_AGENT_FILE_READ_ROOTS=
HSERVER_AGENT_FILE_WRITE_ROOTS=

# PHP-FPM inventory, configuration writes, and lifecycle actions are separate
# local opt-ins. Paths are local distribution policy; the hub sends only a
# validated version and pool basename. Write requires read.
# Example: test,reload,restart
HSERVER_AGENT_ALLOWED_PHP_ACTIONS=
HSERVER_AGENT_ALLOW_PHP_CONFIG_READ=false
HSERVER_AGENT_ALLOW_PHP_CONFIG_WRITE=false
HSERVER_AGENT_PHP_CONFIG_ROOT=/etc/php
HSERVER_AGENT_PHP_BINARY_ROOT=/usr/sbin

# PM2 is scoped to one locally configured runtime identity. Read and action
# capabilities are separate; the hub can select only a validated process name,
# action, and bounded log-line count. Leave the identity fields empty until PM2
# is explicitly enabled for a local user and installation.
HSERVER_AGENT_ALLOW_PM2_READ=false
# Example: start,restart,reload,stop
HSERVER_AGENT_ALLOWED_PM2_ACTIONS=
HSERVER_AGENT_PM2_BINARY=
HSERVER_AGENT_PM2_HOME=
HSERVER_AGENT_PM2_USER=

# Cron inventory, managed-file writes, and manual execution are independent
# capabilities. Write and run require read. Manual run executes only a command
# already stored in the local managed state.
HSERVER_AGENT_ALLOW_CRON_READ=false
HSERVER_AGENT_ALLOW_CRON_WRITE=false
HSERVER_AGENT_ALLOW_CRON_RUN=false
HSERVER_AGENT_CRON_STATE_PATH=/etc/hserver/cron-jobs.json
HSERVER_AGENT_CRON_FILE_PATH=/etc/cron.d/hserver-managed
HSERVER_AGENT_CRON_LOCK_PATH=/run/lock/hserver-cron.lock
HSERVER_AGENT_CRONTAB_BINARY=/usr/bin/crontab
HSERVER_AGENT_RUNUSER_BINARY=/usr/sbin/runuser
HSERVER_AGENT_CRON_SHELL=/bin/bash
HSERVER_AGENT_CRON_SERVICE=cron.service

# IPv4 iptables inventory and HServer-owned rule mutations. Write requires
# read. Protection is active only when both source and port lists overlap a
# proposed DROP rule; keep installation-specific addresses outside Git.
HSERVER_AGENT_ALLOW_FIREWALL_READ=false
HSERVER_AGENT_ALLOW_FIREWALL_WRITE=false
HSERVER_AGENT_IPTABLES_BINARY=/usr/sbin/iptables
HSERVER_AGENT_FIREWALL_SAVE_BINARY=/usr/sbin/netfilter-persistent
HSERVER_AGENT_FIREWALL_LOCK_PATH=/run/lock/hserver-firewall.lock
HSERVER_AGENT_FIREWALL_PERSISTENCE_SERVICE=netfilter-persistent.service
HSERVER_AGENT_FIREWALL_PERSISTENCE_PATH=/etc/iptables
HSERVER_AGENT_FIREWALL_PROTECTED_SOURCES=
HSERVER_AGENT_FIREWALL_PROTECTED_PORTS=
