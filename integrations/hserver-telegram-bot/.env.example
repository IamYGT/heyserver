# Copy to .env and fill in values. Never commit .env or real secrets.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Installation paths
# ---------------------------------------------------------------------------

# Install/work root used by the systemd unit and local commands. Change this
# to the directory where this checkout or package is installed.
HSERVER_BOT_HOME=/var/lib/hserver-telegram-bot

# Persistent subscriber state. An absolute path is recommended; a relative
# value is resolved below HSERVER_BOT_HOME.
HSERVER_BOT_DATA_DIR=/var/lib/hserver-telegram-bot/data

# ---------------------------------------------------------------------------
# Telegram (from @BotFather)
# ---------------------------------------------------------------------------

# Required. Bot API token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Optional. Comma-separated Telegram chat IDs that receive admin notifications
# after /register. Example: -1001234567890,123456789
TELEGRAM_ADMIN_CHAT_IDS=

# Optional. Comma-separated Telegram user IDs allowed to run bot commands.
# When empty, command access is not restricted by user ID.
TELEGRAM_ALLOWED_USER_IDS=

# Optional. Production webhook mode (default: long polling).
# Set TELEGRAM_USE_WEBHOOK=true and provide TELEGRAM_WEBHOOK_URL when behind HTTPS reverse proxy.
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=8443
TELEGRAM_WEBHOOK_PATH=/webhook

# ---------------------------------------------------------------------------
# hserver-panel API
# ---------------------------------------------------------------------------

# Base URL of the running hserver-panel instance (no trailing slash).
HSERVER_BASE_URL=http://127.0.0.1:3085

# Panel admin credentials used for API login (same as the web UI admin).
HSERVER_ADMIN_EMAIL=admin@example.com
HSERVER_ADMIN_PASS=

# Optional absolute path used by the /audit backup healthcheck command.
HSERVER_HEALTHCHECK_SCRIPT=

# Optional. Shared secret for internal cron/backup endpoints (X-Cron-Secret).
# Must match HSERVER_CRON_SECRET in hserver-panel if you trigger backups from the bot.
HSERVER_CRON_SECRET=
