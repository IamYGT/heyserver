{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HServer optional integration catalog",
  "description": "Machine-readable inventory for the integrations listed in docs/optional-integrations.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "documentation",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "./catalog.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "documentation": {
      "$ref": "#/$defs/documentation"
    },
    "entries": {
      "type": "array",
      "minItems": 15,
      "items": {
        "$ref": "#/$defs/entry"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "cloudflare.dns"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "stalwart.mail"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "mail.access"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "backup.gdrive"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "backup.snapshot.restic"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "process.pm2"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "web.nginx"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "runtime.php_fpm"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "firewall.ufw"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "tls.certbot"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "dns.bind9"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "database.local"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "container.docker"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "storage.smartmontools"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"const": "notification.delivery"}}
          }
        }
      ]
    }
  },
  "$defs": {
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_path",
        "table_header",
        "marker_prefix",
        "marker_convention"
      ],
      "properties": {
        "table_path": {
          "const": "docs/optional-integrations.md"
        },
        "table_header": {
          "const": "Integration"
        },
        "marker_prefix": {
          "const": "optional-integrations:v1:"
        },
        "marker_convention": {
          "const": "marker_prefix + slug(display_name), where slug lowercases and joins non-alphanumeric runs with a hyphen"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "purpose",
        "requirement",
        "docs_row_marker",
        "classes",
        "targets",
        "configuration",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "enum": [
            "optional",
            "feature_specific"
          ]
        },
        "docs_row_marker": {
          "type": "string",
          "pattern": "^optional-integrations:v1:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "local_capability",
              "managed_node_capability",
              "provider_adapter",
              "client_surface"
            ]
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "local_host",
              "managed_node"
            ]
          }
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "agent": {
          "$ref": "#/$defs/agent"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classes": {
                "contains": {
                  "const": "managed_node_capability"
                }
              }
            }
          },
          "then": {
            "required": [
              "agent"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "targets": {
                "contains": {
                  "const": "managed_node"
                }
              }
            }
          },
          "then": {
            "required": [
              "agent"
            ]
          }
        }
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "non_secret_keys",
        "secret_key_names",
        "secret_file_refs",
        "boundary"
      ],
      "properties": {
        "non_secret_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          }
        },
        "secret_key_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          }
        },
        "secret_file_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_./-]*$"
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_states",
        "raw_state_mappings",
        "api_route_prefixes"
      ],
      "properties": {
        "canonical_states": {
          "const": [
            "not_configured",
            "unavailable",
            "healthy"
          ]
        },
        "raw_state_mappings": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/raw-state-mapping"
          }
        },
        "api_route_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/api(?:/|$)"
          }
        }
      }
    },
    "raw-state-mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "canonical",
        "meaning"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "enum": [
            "not_configured",
            "unavailable",
            "healthy"
          ]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "capabilities",
        "evidence"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^Task[A-Za-z0-9_]+$"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^Capability[A-Za-z0-9_]+$"
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tasks",
            "capabilities"
          ],
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/evidence-item"
              }
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/evidence-item"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "web",
        "docs",
        "tests"
      ],
      "properties": {
        "web": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence-item"
          }
        },
        "docs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence-item"
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence-item"
          }
        }
      }
    },
    "evidence-item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "claim"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\./).+"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
